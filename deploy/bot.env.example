# /etc/zcribe/bot.env — chmod 600, owned by the zcribe user.
#
# Anything that can read this file can post as the bot, so it is the one
# credential in this deployment that is not derivable from public data.
# If it leaks, revoke it with /revoke in @BotFather and issue a new one.
ZCRIBE_TELEGRAM_TOKEN=123456:replace-me
ZCRIBE_TELEGRAM_CHANNEL=-1001234567890

# Used by `zcribe moderate -purge`, not by the bot. Kept here so there is one
# place to look for the operator's secrets.
ZCRIBE_CONTENT_ORIGIN=https://content.zenon.foo
ZCRIBE_CF_ZONE=
ZCRIBE_CF_TOKEN=
