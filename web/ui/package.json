    "verify:vectors": "node scripts/check-vectors.mjs"
  },
  "dependencies": {
    "@lucide/vue": "^1.20.0",
    "@vueuse/core": "^14.2.0",
    "nom-ui": "github:digitalSloth/nom-ui",
