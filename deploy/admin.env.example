# /etc/zcribe/admin.env — chmod 600, owned by the zcribe user.
#
# Anything that can read this file can act as the admin: set every asset's
# moderation policy, run bulk import/export, and trigger a CDN purge — the
# same authority as `zcribe moderate`, just reachable from a browser at
# /admin instead of a shell on this host. If it leaks, change it and restart
# zcribe (systemctl restart zcribe); every existing session is signed with a
# secret this process holds, not with the password itself, so nothing here
# needs rotating beyond the password.
#
# Leave this file absent (or this line empty) to run without an admin panel
# at all — that is a supported choice, not a partial setup. See
# deploy/README.md §5.
ZCRIBE_ADMIN_PASSWORD=

# Used by `zcribe moderate -purge` and the admin panel's purge action alike.
# See deploy/bot.env.example, where these are also documented — one or the
# other file is fine, this is duplicated here only so admin.env is a complete
# picture on its own.
ZCRIBE_CONTENT_ORIGIN=https://content.zenon.foo
ZCRIBE_CF_ZONE=
ZCRIBE_CF_TOKEN=
