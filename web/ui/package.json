{
  "name": "zcribe-ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Zenoglyphs inscription viewer \u2014 the UI `zcribe serve` embeds and serves.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
